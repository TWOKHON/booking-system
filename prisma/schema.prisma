  providerName    String
  accountName     String
  maskedDetails   String
  isDefault       Boolean                  @default(false)
  isActive        Boolean                  @default(true)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  tenantProfile   TenantProfile            @relation(fields: [tenantProfileId], references: [id], onDelete: Cascade)

  @@unique([tenantProfileId, accountLabel])
  @@index([tenantProfileId, accountType])
  @@map("tenant_payment_account")
}

model TenantDiscordChannel {
